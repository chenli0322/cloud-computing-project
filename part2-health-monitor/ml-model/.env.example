# If set, ml_node.py downloads the model artifact from S3 at startup.
# Leave empty to load from local models/anomaly_model.joblib instead.
MODEL_S3_URI=s3://cl5725-health-monitor-anomalies/models/anomaly_model.joblib

# AWS credentials (only needed if MODEL_S3_URI is set)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Copy to .env and fill in.
# NEVER commit .env to git. Used by Hardhat (deploy.js) and the Python BC node.

# --- Sepolia / Web3 ---
# Infura / Alchemy Sepolia RPC URL. Get one free at https://www.infura.io/
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of your Sepolia wallet (export from MetaMask → Account Details → Export Private Key).
# 64 hex chars, NO leading 0x.
PRIVATE_KEY=your_private_key_without_0x_prefix

# Filled in AFTER deploy.js runs successfully.
HEALTHLOG_ADDRESS=

# --- AWS S3 archival (off-chain raw anomaly store) ---
# IAM user with PutObject + GetObject on the bucket.
# Leave these blank to disable archival; the BC node will still run.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ANOMALY_S3_BUCKET=cl5725-health-monitor-anomalies
